/* Metro-like Dark Theme */
QWidget {
    background-color: #252525;
    color: #FFFFFF;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #333333;
    background: #252525;
}

QTabBar::tab {
    background: #252525;
    color: #999999;
    padding: 8px 20px;
    font-size: 16px;
    border: none;
}

QTabBar::tab:selected {
    color: #FFFFFF;
    border-bottom: 2px solid #00AEEF; /* Accent color */
}

QTabBar::tab:hover:!selected {
    background: #333333;
    color: #CCCCCC;
}

/* Push Button - ToolBar style */
QToolBar QPushButton {
    background: transparent;
    border: none;
    padding: 5px 10px;
}

QToolBar QPushButton:hover {
    background: #333333;
}

QToolBar QPushButton:pressed {
    background: #00AEEF;
}

/* Sound Button */
QPushButton#SoundButton {
    background-color: #3B3B3B;
    border: 2px solid transparent;
    border-radius: 2px;
    font-size: 15px;
    padding: 6px;
    qproperty-wordWrap: true;
}

QPushButton#SoundButton:hover {
    border: 2px solid #555555;
}

QPushButton#SoundButton:pressed {
    background-color: #00AEEF;
}

QPushButton#SoundButton[selected="true"] {
    border: 2px solid #00AEEF;
}

/* Dialogs */
QDialog {
    background-color: #252525;
}

QLineEdit {
    background-color: #333333;
    border: 1px solid #555555;
    padding: 5px;
    color: white;
}

QLineEdit:focus {
    border: 1px solid #00AEEF;
}

QMenu {
    background-color: #2B2B2B;
    border: 1px solid #111111;
}

QMenu::item {
    padding: 5px 30px 5px 20px;
}

QMenu::item:selected {
    background-color: #00AEEF;
    color: white;
}

/* Scrollbar */
QScrollBar:vertical {
    background: #1E1E1E;
    width: 8px;
    border: none;
}
QScrollBar::handle:vertical {
    background: #444;
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover { background: #666; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }

/* Slider (VolumeDialog) */
QSlider::groove:horizontal {
    height: 4px;
    background: #444;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #00AEEF;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::sub-page:horizontal { background: #00AEEF; border-radius: 2px; }

/* Search Panel */
QWidget#SearchPanel {
    background-color: #1A2A35;
    border-bottom: 1px solid #00AEEF;
}

QLineEdit#SearchInput {
    background-color: #1E1E1E;
    border: 1px solid #444;
    border-radius: 3px;
    padding: 4px 8px;
    color: #FFFFFF;
    font-size: 13px;
    selection-background-color: #00AEEF;
}

QLineEdit#SearchInput:focus {
    border: 1px solid #00AEEF;
    background-color: #252525;
}

/* Dialog Buttons */
QDialogButtonBox QPushButton {
    background: #3B3B3B;
    color: #CCC;
    border: none;
    border-radius: 3px;
    padding: 5px 16px;
    min-width: 60px;
}
QDialogButtonBox QPushButton:hover { background: #555; }
QDialogButtonBox QPushButton:pressed { background: #00AEEF; color: #000; }
