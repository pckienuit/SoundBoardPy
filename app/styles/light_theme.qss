/* SoundBoard Light Theme */
QWidget {
    background-color: #F5F5F5;
    color: #1A1A1A;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}

QTabWidget::pane {
    border: 1px solid #CCCCCC;
    background: #F5F5F5;
}

QTabBar::tab {
    background: #F5F5F5;
    color: #666666;
    padding: 8px 20px;
    font-size: 16px;
    border: none;
}

QTabBar::tab:selected {
    color: #1A1A1A;
    border-bottom: 2px solid #0095CC;
}

QTabBar::tab:hover:!selected {
    background: #E8E8E8;
    color: #333333;
}

QPushButton#SoundButton {
    background-color: #E0E0E0;
    border: 2px solid transparent;
    border-radius: 2px;
    font-size: 15px;
    padding: 6px;
    color: #1A1A1A;
}

QPushButton#SoundButton:hover {
    border: 2px solid #AAAAAA;
}

QPushButton#SoundButton:pressed {
    background-color: #0095CC;
    color: #FFFFFF;
}

QPushButton#SoundButton[selected="true"] {
    border: 2px solid #0095CC;
}

QDialog {
    background-color: #F5F5F5;
}

QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    padding: 5px;
    color: #1A1A1A;
}

QLineEdit:focus {
    border: 1px solid #0095CC;
}

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    color: #1A1A1A;
}

QMenu::item {
    padding: 5px 30px 5px 20px;
}

QMenu::item:selected {
    background-color: #0095CC;
    color: white;
}

QScrollBar:vertical {
    background: #E8E8E8;
    width: 8px;
    border: none;
}
QScrollBar::handle:vertical {
    background: #BBBBBB;
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover { background: #999; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }

QSlider::groove:horizontal {
    height: 4px;
    background: #CCCCCC;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #0095CC;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::sub-page:horizontal { background: #0095CC; border-radius: 2px; }

QWidget#SearchPanel {
    background-color: #E8F4FB;
    border-bottom: 1px solid #0095CC;
}

QLineEdit#SearchInput {
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    border-radius: 3px;
    padding: 4px 8px;
    color: #1A1A1A;
    font-size: 13px;
    selection-background-color: #0095CC;
}

QLineEdit#SearchInput:focus {
    border: 1px solid #0095CC;
}

QDialogButtonBox QPushButton {
    background: #E0E0E0;
    color: #1A1A1A;
    border: none;
    border-radius: 3px;
    padding: 5px 16px;
    min-width: 60px;
}
QDialogButtonBox QPushButton:hover { background: #CCCCCC; }
QDialogButtonBox QPushButton:pressed { background: #0095CC; color: #FFF; }

QComboBox {
    background: #FFFFFF;
    border: 1px solid #CCCCCC;
    border-radius: 3px;
    padding: 4px 8px;
    color: #1A1A1A;
}
QComboBox:focus { border: 1px solid #0095CC; }
QComboBox::drop-down { border: none; }
QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #CCCCCC;
    selection-background-color: #0095CC;
    selection-color: #FFF;
}

/* ─── Timeline Panel ─────────────────────────────────── */

QWidget#TimelinePanel {
    background-color: #E8E8E8;
    border-top: 1px solid #CCCCCC;
}

QWidget#TimelineHeader {
    background-color: #F0F0F0;
    border-bottom: 1px solid #CCCCCC;
}

QPushButton#TimelineToggle {
    background: transparent;
    color: #666666;
    border: none;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: bold;
}
QPushButton#TimelineToggle:hover {
    color: #1A1A1A;
    background: #D8D8D8;
}

QWidget#TimelineBody {
    background-color: #E8E8E8;
}

QWidget#SoundStrip {
    background-color: #F8F8F8;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
}
QWidget#SoundStrip:hover {
    border: 1px solid #0095CC;
}

QLabel#StripName {
    color: #333333;
    font-size: 11px;
    font-weight: bold;
}

QLabel#StripVol {
    color: #0095CC;
    font-size: 10px;
    font-weight: bold;
}

QLabel#CrossfadeVal {
    color: #0095CC;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#FadeAllBtn {
    background: #E0F0E0;
    color: #228822;
    border: 1px solid #AACFAA;
    border-radius: 3px;
    padding: 2px 10px;
    font-size: 11px;
}
QPushButton#FadeAllBtn:hover {
    background: #CCEECC;
}

QPushButton#StopAllBtn {
    background: #F0E0E0;
    color: #CC2222;
    border: 1px solid #DFAAAA;
    border-radius: 3px;
    padding: 2px 10px;
    font-size: 11px;
}
QPushButton#StopAllBtn:hover {
    background: #FFDDDD;
}

QPushButton#StripStop {
    background: #E8E8E8;
    color: #CC2222;
    border: 1px solid #CCCCCC;
    border-radius: 3px;
    font-size: 10px;
    padding: 0px;
}
QPushButton#StripStop:hover {
    background: #DDDDDD;
    color: #AA0000;
}

/* Scroll area inside timeline */
QScrollArea#TimelineScroll {
    background: transparent;
    border: none;
}
QScrollArea#TimelineScroll > QWidget {
    background: transparent;
}

/* Progress bar in timeline */
QProgressBar {
    border: none;
    background: #D8D8D8;
    border-radius: 3px;
    height: 8px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0095CC, stop:0.6 #00AA66, stop:0.85 #CCCC00, stop:1 #CC2200);
    border-radius: 3px;
}

/* Group boxes in dialog */
QGroupBox {
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 8px;
    font-size: 12px;
    color: #666666;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
    color: #0095CC;
}
